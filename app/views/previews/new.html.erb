<% content_for :page_title, "New preview" %>
<% content_for :back_link do %>
  <%= render "govuk_publishing_components/components/back_link", href: previews_path %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <% if @preview.errors.any? %>
      <%= render "govuk_publishing_components/components/error_summary", {
        title: "There is a problem",
        items: @preview.errors.map { |error| { text: error.full_message, href: "#preview_#{error.attribute}" } },
      } %>
    <% end %>

    <h1 class="govuk-heading-xl">New preview</h1>

    <p class="govuk-body">
      Runs a branch of a GOV.UK application at its own address, alongside a dedicated copy of the services it
      depends on, each running <code>main</code>. By default that's just its core dependencies (e.g. Publishing
      API for Whitehall).
    </p>

    <%= form_with url: previews_path, method: :post do %>
      <%= render "govuk_publishing_components/components/select", {
        id: "preview_app_name",
        name: "preview[app_name]",
        label: "Application",
        heading_size: "s",
        error_message: @preview.errors[:app_name].first,
        options: GovukApps.app_names.map { |name| { text: name, value: name, selected: @preview.app_name == name } },
      } %>

      <%= render "govuk_publishing_components/components/input", {
        id: "preview_branch",
        name: "preview[branch]",
        label: { text: "Branch" },
        heading_size: "s",
        hint: branch_hint,
        error_message: @preview.errors[:branch].first,
        value: @preview.branch,
      } %>

      <%= render "govuk_publishing_components/components/checkboxes", {
      name: "preview[full_stack]",
      heading: "Stack",
      heading_size: "s",
      no_hint_text: true,
      items: [
        {
          label: "Full stack",
          value: "true",
          checked: @preview.full_stack?,
          hint: "Also runs Content Store, draft Content Store, Frontend and draft Frontend, so published and draft " \
                "pages can be viewed - roughly twice the memory. Can be added or removed later.",
        },
      ],
    } %>

    <%= render "govuk_publishing_components/components/button", text: "Create preview" %>
    <% end %>
  </div>
</div>
