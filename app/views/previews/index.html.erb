<% content_for :page_title, "Previews" %>

<%= render "govuk_publishing_components/components/heading", text: "Previews", heading_level: 1, margin_bottom: 6 %>

<%= render "govuk_publishing_components/components/button", text: "New preview", href: new_preview_path %>

<%= render "govuk_publishing_components/components/table", {
  head: [
    { text: "App" },
    { text: "Branch" },
    { text: "Status" },
    { text: "URL" },
    { text: "Created at" },
    { text: "Last visited" },
    { text: "" },
  ],
  rows: previews_with_dependencies(@previews).map do |preview, dependency|
    # A sleeping preview keeps its link - visiting it wakes it up.
    url_cell = if !(preview.running? || preview.sleeping? || preview.waking?)
                 ""
               elsif preview.parent.present? && !preview.publicly_readable?
                 "Internal dependency"
               else
                 link_to(preview.hostname, preview.url, class: "govuk-link")
               end

    status_cell = render("govuk_publishing_components/components/tag", text: preview.status)
    if preview.sleeping? && preview.parent.blank? && preview.status_message.blank?
      status_cell += tag.p("Wakes up when visited", class: "govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-1")
    end
    if preview.status_message.present?
      status_cell += tag.p(preview.status_message, class: "govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-1")
    end

    [
      { text: preview_app_name_cell(preview, dependency) },
      { text: preview.branch },
      { text: status_cell },
      { text: url_cell },
      { text: preview_time(preview.created_at) },
      # Visits are recorded against the whole stack, i.e. its top-level preview.
      { text: preview.parent.blank? ? preview_time(preview.last_accessed_at, blank: "Never") : "" },
      { text: preview.parent.blank? ? preview_actions(preview) : "" },
    ]
  end,
} %>
