<% content_for :page_title, "Previews" %>

<%= render "govuk_publishing_components/components/heading", text: "Previews", heading_level: 1, margin_bottom: 6 %>

<%= render "govuk_publishing_components/components/button", text: "New preview", href: new_preview_path %>

<%= render "govuk_publishing_components/components/table", {
  head: [
    { text: "App" },
    { text: "Branch" },
    { text: "Status" },
    { text: "URL" },
    { text: "" },
  ],
  rows: previews_with_depth(@previews).map do |preview, depth|
    url_cell = if preview.parent.present?
                 "Internal dependency"
               elsif preview.running?
                 link_to(preview.hostname, preview.url)
               else
                 ""
               end

    status_cell = render("govuk_publishing_components/components/tag", text: preview.status)
    if preview.status_message.present?
      status_cell += tag.p(preview.status_message, class: "govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-1")
    end

    [
      { text: preview_app_name_cell(preview, depth) },
      { text: preview.branch },
      { text: status_cell },
      { text: url_cell },
      { text: preview.parent.blank? ? button_to("Delete", preview_path(preview), method: :delete, class: "govuk-button govuk-button--warning govuk-!-margin-bottom-0", data: { confirm: "Are you sure?" }) : "" },
    ]
  end,
} %>
