<% environment = GovukPublishingComponents::AppHelpers::Environment.current_acceptance_environment %>

<%= render "govuk_publishing_components/components/layout_for_admin",
    product_name: "Preview App",
    environment: environment,
    browser_title: yield(:page_title) do %>

  <%= render "govuk_publishing_components/components/skip_link" %>

  <%= render "govuk_publishing_components/components/layout_header", {
    product_name: "Preview App",
    environment: environment,
    navigation_items: [
      {
        text: "Dashboard",
        href: previews_path,
        active: request.path.start_with?(previews_path),
      },
      {
        text: "Switch app",
        # external_url_for, not find: GOVUK_APP_DOMAIN (what find uses) is
        # "" (empty) in the shared govuk-apps-env ConfigMap every app
        # gets - only GOVUK_APP_DOMAIN_EXTERNAL is ever actually set, to
        # the real public domain, which external_url_for reads instead.
        # That's deliberate upstream: internal service-to-service lookups
        # (find) and a link meant for a human's browser (external_url_for)
        # aren't always the same thing - this is the latter.
        href: Plek.external_url_for("signon"),
      },
    ],
  } %>

  <div class="govuk-width-container">
    <%= yield(:back_link) %>

    <main class="govuk-main-wrapper" id="main-content" role="main">
      <%= render "govuk_publishing_components/components/success_alert", message: flash[:notice] if flash[:notice] %>
      <%= render "govuk_publishing_components/components/error_alert", message: flash[:alert] if flash[:alert] %>

      <%= yield %>
    </main>
  </div>

  <%= render "govuk_publishing_components/components/layout_footer" %>
<% end %>
